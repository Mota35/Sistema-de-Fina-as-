# ============================================================
# FINANCE MANAGER API - Environment Configuration
# ============================================================

APP_NAME="Finance Manager API"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_manager
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@finance.com
MAIL_PASSWORD=mail_password
MAIL_FROM_ADDRESS=noreply@finance.com
MAIL_FROM_NAME="Finance Manager"

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=storage/uploads
AVATAR_PATH=storage/uploads/avatars
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# External APIs
EXCHANGE_RATE_API_KEY=5e34fc8d076c7e9c591ccc58
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# Financial Modeling Prep (cotações de ações, crypto, índices)
FMP_API_KEY=Kz7kiNlGTBLvpsx4Dfds7zK4b0wV387t

# Logs
LOG_PATH=storage/logs
LOG_LEVEL=debug

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
